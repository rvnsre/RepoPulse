{
  "name": "repopulse",
  "version": "11.6.0",
  "description": "Your daily open-source signal. A private, personalized GitHub discovery island.",
  "main": "app/main.cjs",
  "license": "UNLICENSED",
  "author": {
    "name": "Ravan Sariyev",
    "email": "242032059+rvnsre@users.noreply.github.com"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "check": "node scripts/check.cjs",
    "dist": "electron-builder --publish never",
    "dist:dir": "electron-builder --dir --publish never",
    "smoke": "electron . --smoke-test",
    "preview": "node scripts/preview.cjs"
  },
  "devDependencies": {
    "electron": "40.0.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "dev.rvnsre.repopulse",
    "productName": "RepoPulse",
    "files": [
      "app/**/*",
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Development"
    }
  },
  "homepage": "https://github.com/rvnsre/RepoPulse"
}
