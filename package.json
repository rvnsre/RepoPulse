{
  "name": "repopulse",
  "version": "11.7.1",
  "description": "Your daily open-source signal. A private, personalized GitHub discovery island.",
  "main": "app/main.cjs",
  "license": "UNLICENSED",
  "author": {
    "name": "Ravan Sariyev",
    "email": "242032059+rvnsre@users.noreply.github.com"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "check": "node scripts/check.cjs",
    "dist": "electron-builder --publish never",
    "dist:dir": "electron-builder --dir --publish never",
    "smoke": "electron . --smoke-test",
    "preview": "node scripts/preview.cjs"
  },
  "devDependencies": {
    "electron": "45.3.4",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "dev.rvnsre.repopulse",
    "productName": "RepoPulse",
    "files": [
      "app/**/*",
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "RepoPulse-${version}-Windows-${arch}-Setup.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "artifactName": "RepoPulse-${version}-macOS-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "artifactName": "RepoPulse-${version}-Linux-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "RepoPulse-${version}-Windows-${arch}-Portable.${ext}"
    }
  },
  "homepage": "https://github.com/rvnsre/RepoPulse",
  "overrides": {
    "minimatch": "11.0.9"
  }
}
